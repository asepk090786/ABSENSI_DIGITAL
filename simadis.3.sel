(1800,7,41,'kbm',17,'2026-08-04','<ol>\r\n<li>Melakukan apersepsi materi pertemuan sebelumnya yaitu sifat-sifat pangkat positif.</li>\r\n<li>&nbsp;Melakukan diskusi kelompok melalui gim edukasi Ruang Murid (eksloprasi petualangan Bilangan Eksponensial).</li>\r\n<li>Murid mempresentasikan hasil diskusi dan petualangan gim edukasi di Ruang Murid (eksplorasi petualangan bilangan eksponen) melalui pemanfaatan layar PID.</li>\r\n<li>Merefleksikan hasil pembelajaran.</li>\r\n<li>Menutup pembelajaran</li>\r\n</ol>',NULL,NULL,NULL,NULL,NULL,NULL,NULL,1,1,'2026-08-04 12:44:00','2026-08-04 12:44:57'),
(1801,12,41,'kbm',37,'2026-08-04','<ol>\r\n<li>Melakukan apersepsi materi pertemuan sebelumnya yaitu bentuk umum polinomial dan ciri bukan polinomial.</li>\r\n<li>Melakukan diskusi secara virtual dari masalah operasi polinomial yaitu operasi penjumlahan, pengurangan dan perkalian polinomial.</li>\r\n<li>Perwakilan murid mempresentasikan hasil penyelesaian masalah operasi pengurangan dan perkalian fungsi polinomial.</li>\r\n<li>Merefleksikan bersama murid lainnya untuk bisa memberikan feedback hasil presentasi temannya.</li>\r\n<li>Merefleksikan pembelajaran bersama.</li>\r\n<li>Menutup pembelajaran dgn doa.</li>\r\n</ol>',NULL,NULL,NULL,NULL,NULL,NULL,NULL,1,1,'2026-08-04 12:57:43','2026-08-04 12:57:43'),
