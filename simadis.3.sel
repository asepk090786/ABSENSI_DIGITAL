  KEY `attendance_verification_codes_tanggal_index` (`tanggal`),
  KEY `attendance_verification_codes_kode_index` (`kode`),
  KEY `attendance_verification_codes_expires_at_index` (`expires_at`)
) ENGINE=InnoDB AUTO_INCREMENT=15 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
