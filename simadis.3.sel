DROP TABLE IF EXISTS `absensi_siswa_history`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!40101 SET character_set_client = utf8mb4 */;
CREATE TABLE `absensi_siswa_history` (
  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,
  `absensi_siswa_id` bigint(20) unsigned DEFAULT NULL,
  `absensi_kelas_id` bigint(20) unsigned DEFAULT NULL,
  `siswa_id` bigint(20) unsigned DEFAULT NULL,
  `previous_status` varchar(191) DEFAULT NULL,
  `new_status` varchar(191) DEFAULT NULL,
  `previous_keterangan` text DEFAULT NULL,
  `new_keterangan` text DEFAULT NULL,
  `changed_by` bigint(20) unsigned DEFAULT NULL,
  `created_at` timestamp NULL DEFAULT NULL,
  `updated_at` timestamp NULL DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `absensi_siswa_history_absensi_siswa_id_index` (`absensi_siswa_id`),
  KEY `absensi_siswa_history_absensi_kelas_id_index` (`absensi_kelas_id`),
  KEY `absensi_siswa_history_siswa_id_index` (`siswa_id`),
  KEY `absensi_siswa_history_changed_by_index` (`changed_by`)
) ENGINE=InnoDB AUTO_INCREMENT=29996 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
