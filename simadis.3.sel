/*!40000 ALTER TABLE `capaian_pembelajarans` DISABLE KEYS */;
INSERT INTO `capaian_pembelajarans` VALUES
(7,'Memahami Jenis dan Sifat Larutan berdasarkan daya hantar listriknya','Murid mampu memahami Jenis dan Sifat Larutan berdasarkan daya hantar listriknya','Murid akan mampu menguasai materi larutan elekrolit dan non elektrolit, larutan koloid dan sifat koligatif larutan melalui berbagai aktivitas individu dan kelompok baik aspek pemahaman kimia dan atau keterampilan proses','1. Membedakan larutan dengan koloid dan suspensi.\r\n2. Menjelaskan pengertian larutan, koloid, dan suspensi.\r\n3. Menjelaskan pengertian larutan elektrolit dan nonelektrolit serta aplikasinya dalam kehidupan.','Murid mampu ; \r\n1. membedakan jenis larutan berdasarkan daya hantar listrik \r\n2. memahami penerapan konsep melalui analisis uji elektrolit larutan','F',NULL,3,'2026-07-29 19:09:07','2026-07-30 18:06:53'),
(8,'Mengidentifikasi peran dan penerapan ilmu kimia dalam kehidupan sehari-hari','MUrid mampu mengidentifikasi peran ilmu kimia dalam kehidupan keseharian di lingkungannya sesuai dengan pengetahuan dan pengalaman yang dimilikinya.','Menjelaskan hakikat ilmu kimia dan penerapannya dalam membahas isu-isu global dengan bahasa sendiri yang lebih sederhana serta mudah dimengerti.','Menjelaskan hakikat ilmu kimia, \r\nMenjelaskan peran kimia dalam kehidupan dan perkembangan ilmu lain \r\nMenentukan contoh produk bahan-bahan kimia dalam kehidupan sehari-hari','Murid mampu menjelaskan hakikat ilmu kimia\r\nMurid mampu menjelaskan peran kimia dalam kehidupan dalam berbagai bidang\r\nMurid mampu mencontohkan produk / bahan kimia yang ada di sekeliling kehidupanya','E',NULL,34,'2026-07-30 19:41:08','2026-07-30 19:41:08'),
(9,'.....','.....','....','....','....','F',NULL,14,'2026-08-03 02:26:45','2026-08-04 14:44:26'),
(10,'Memahami persamaan lingjaran','Lingkaran','Lingkaran','Lingkaran','Lingkaran','F',NULL,3,'2026-08-05 02:13:00','2026-08-05 02:13:00'),
(11,'Menganalisis ruang lingkup sejarah dan cara berpikir sejarah dari peristiwa kemerdekaan Indonesia','Peserta didik mampu memahami dan menjelaskan ruang lingkup sejarah serta cara berpikir sejarah melalui kajian peristiwa kemerdekaan Indonesia. Pembelajaran ini menekankan pada pemahaman konsep dasar sejarah seperti ruang, waktu, perubahan, dan keberlanjutan, serta penerapan cara berpikir kronologis, kausalitas, dan interpretatif dalam menganalisis peristiwa proklamasi kemerdekaan Indonesia. Dengan demikian, peserta didik diharapkan mampu mengaitkan fakta sejarah dengan konteks yang lebih luas serta menumbuhkan sikap kritis dan apresiatif terhadap perjuangan bangsa.','Peserta didik mampu menganalisis ruang lingkup sejarah dan cara berpikir sejarah dari peristiwa kemerdekaan Indonesia','1. Peserta didik mengenal pengertian sejarah dan ruang lingkup sejarah.\r\n2. Peserta didik memahami konsep waktu (kronologi) dalam sejarah.\r\n3. Peserta didik memahami konsep perubahan dan keberlanjutan dalam sejarah.\r\n4. Peserta didik memahami konsep sebab-akibat (kausalitas) dalam peristiwa sejarah.\r\n5. Peserta didik menganalisis peristiwa kemerdekaan Indonesia secara kronologis.\r\n6. Peserta didik mengidentifikasi faktor penyebab dan dampak peristiwa kemerdekaan Indonesia.\r\n7. Peserta didik menyajikan hasil analisis tentang peristiwa kemerdekaan Indonesia dalam bentuk lisan atau tulisan.','1. Menjelaskan pengertian dan ruang lingkup sejarah dengan tepat.\r\n2. Mengurutkan peristiwa-peristiwa menjelang kemerdekaan Indonesia secara kronologis.\r\n3. Menjelaskan konsep perubahan dan keberlanjutan dalam peristiwa kemerdekaan Indonesia.\r\n4. Mengidentifikasi hubungan sebab-akibat dalam peristiwa kemerdekaan Indonesia.\r\n5. Menyebutkan tokoh dan peran penting dalam peristiwa kemerdekaan Indonesia.\r\n6. Menganalisis makna peristiwa kemerdekaan Indonesia bagi kehidupan bangsa.\r\n7. Menyajikan hasil analisis dalam bentuk presentasi atau tulisan secara sistematis.','E',NULL,29,'2026-08-05 03:21:38','2026-08-05 03:21:38'),
(12,'Mendeskripsikan rumusan dan keterkaitan  sila-sila dalam Pancasila; menganalisis peluang  dan tantangan penerapan nilai-nilai Pancasila  dalam kehidupan global dalam konteks  Pancasila  sebag','Pembelajaran ini bertujuan untuk membangun pemahaman peserta didik tentang rumusan dan keterkaitan antar sila dalam Pancasila sebagai dasar negara dan ideologi nasional. Peserta didik diajak untuk menganalisis relevansi nilai-nilai Pancasila dalam menghadapi tantangan globalisasi serta mengidentifikasi peluang penerapannya dalam kehidupan modern. Selain itu, pembelajaran menekankan pada pembiasaan sikap dan perilaku yang mencerminkan nilai-nilai Pancasila dalam kehidupan sehari-hari sebagai wujud identitas nasional.','Peserta didik mampu mendeskripsikan rumusan dan keterkaitan sila-sila dalam Pancasila, menganalisis peluang dan tantangan penerapan nilai-nilai Pancasila dalam kehidupan global sebagai ideologi negara, serta membiasakan perilaku yang sesuai dengan nilai-nilai Pancasila sebagai identitas nasional dalam kehidupan sehari-hari.','1. Peserta didik memahami rumusan sila-sila Pancasila.\r\n2. Peserta didik menjelaskan makna setiap sila dalam Pancasila.\r\n3. Peserta didik menganalisis keterkaitan antar sila dalam Pancasila.\r\n4. Peserta didik mengidentifikasi nilai-nilai yang terkandung dalam Pancasila.\r\n5. Peserta didik menganalisis peluang penerapan nilai Pancasila dalam kehidupan global.\r\n6. Peserta didik menganalisis tantangan penerapan nilai Pancasila di era globalisasi.\r\n7. Peserta didik mengaitkan Pancasila sebagai ideologi negara dalam kehidupan berbangsa.\r\n8. Peserta didik menunjukkan perilaku yang mencerminkan nilai-nilai Pancasila dalam kehidupan sehari-hari.','1. Menyebutkan dan menjelaskan rumusan lima sila Pancasila dengan benar.\r\n2. Menjelaskan makna masing-masing sila Pancasila secara tepat.\r\n3. Menjelaskan hubungan dan keterkaitan antar sila dalam Pancasila.\r\n4. Mengidentifikasi nilai-nilai yang terkandung dalam setiap sila.\r\n5. Memberikan contoh peluang penerapan nilai Pancasila dalam kehidupan global.\r\n6. Mengidentifikasi tantangan dalam menerapkan nilai Pancasila di era globalisasi.\r\n7. Menjelaskan peran Pancasila sebagai ideologi negara.\r\n8. Menunjukkan perilaku yang sesuai dengan nilai-nilai Pancasila dalam kehidupan sehari-hari.','F',NULL,29,'2026-08-05 03:27:05','2026-08-05 03:27:05');
/*!40000 ALTER TABLE `capaian_pembelajarans` ENABLE KEYS */;
UNLOCK TABLES;
COMMIT;
SET AUTOCOMMIT=@OLD_AUTOCOMMIT;

