(1,'SMA NEGERI 1 PONTANG','EDI KOCOWAHONO, S.Pd, MM','20605092','-',NULL,NULL,NULL,'Banten','Banten',NULL,NULL,NULL,NULL,1,1,1,1,1,1,'<h2 class=\"ql-align-center\"><strong>Jadwal KBM Sedang Dalam Perbaikan</strong></h2><h2 class=\"ql-align-center\">Mohon maaf atas ketidaknyamanannya. Jadwal Kegiatan Belajar Mengajar sedang dalam proses perbaikan. Harap menunggu hingga proses selesai.</h2><h1 class=\"ql-align-center\"><br></h1>','<p>DALAM PROSES</p>','PEMERINTAH PROVINSI BANTEN',1.0,'SMA NEGERI 1 PONTANG',1.0,'jl kubang puji desa pontang',1.0,NULL,1.0,NULL,'SMA','Negeri','A','logos/Z8AP2YIE9PPR58nr5AeOyJxCLUKgo6cf1shsUS94.png','logos/o4K2dUKeNy59dNmQgCxmhrcX9s7lAVFjNHqQeKOk.png',NULL,'2026-07-14 22:13:03','2026-07-18 03:12:52');
