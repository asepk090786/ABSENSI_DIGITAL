INSERT INTO `pembinaan_bk` VALUES
(1,6,42,316,'Nur Fairuz Fatin',29,0,0,0,0,'Masalah dengan teman kelasnya karena merasa dibully oleh temannya','Pembinaan langsung dengan Tantri di ruang BK, kemudian dipanggil teman yang bersangkutan untuk menyelesaikan masalah/mencari solusi.',NULL,'Rekap Absensi: Hadir 29, Sakit 0, Izin 0, Alpa 0, Terlambat 0.',NULL,NULL,'[\"pembinaan_bk\\/uEslowZWsaqL7zBKfpZGOWQLhPDrbdfHGY4eU9D4.jpg\",\"pembinaan_bk\\/EvNEh3p5VDBFLS6uV0QRRPmkB14r1l2XNHltg0wn.jpg\"]','2026-08-03 01:52:12','2026-08-03 01:52:12'),
(2,11,44,457,'Nurjannah Triastuti Rahajeng, S.Hi',18,0,0,13,1,'Absensi, dari rumah berangkat tetapi tidak masuk sekolah. Alasan nya karna malas banyak tugas dan ga mau nulis banyak. Selama bolos nongkrong di tempat PS bersama teman dari MTS nya','Penanganan yang di berikan kepada siswa adalah motivasi untuk berangkat sekolah,','Guru bk memberikan waktu selama 1 minggu ini untuk rajin sekolah, jika masih ada absen maka di berlakukan sangksi','Rekap Absensi: Hadir 18, Sakit 0, Izin 0, Alpa 13, Terlambat 1.',NULL,NULL,'[\"pembinaan_bk\\/POrCXZH0SvrgKetYrEqP0GMOlEJY9fZLU6Vrc7nQ.jpg\",\"pembinaan_bk\\/AybYPWjjf0tUz5zzuCu4DwBevpIlvkebW8v95ams.jpg\"]','2026-08-03 03:12:39','2026-08-03 03:12:39'),
(3,1,42,127,'Fina Faelasufatunnajah,M.Pd',130,0,0,0,0,'Kesulitan dalam membaca','Bimbingan belajar baca di ruang BK',NULL,'Rekap Absensi: Hadir 130, Sakit 0, Izin 0, Alpa 0, Terlambat 0.',NULL,NULL,'[\"pembinaan_bk\\/lKxkSZcW2NfAMlbDUA2fsO9HLjBnPdsRPAern181.jpg\"]','2026-08-05 07:20:46','2026-08-05 07:20:46');
/*!40000 ALTER TABLE `pembinaan_bk` ENABLE KEYS */;
UNLOCK TABLES;
COMMIT;
SET AUTOCOMMIT=@OLD_AUTOCOMMIT;

