(1,'PENGEMBANGAN DIRI','“Transformasi Paradigma Pendidikan melalui Digitalisasi Sekolah  dalam Mewujudkan Layanan Pendidikan yang Berkualitas, Inovatif, dan Berkelanjutan','IHT',NULL,'800.3.8/178/SMAN1PONTANG/2026',1,'[\"Mukhlish,ST,M.Pd\",\"Asep Kurniawan\"]','2026-07-23','2026-07-26','2026-08-05 02:40:57','2026-08-05 02:43:38');
