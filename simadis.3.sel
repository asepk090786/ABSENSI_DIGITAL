(1798,7,41,'kbm',7,'2026-08-04','<ol>\r\n<li>Melakukan apersepsi materi pertemuan sebelumnya yaitu sifat-sifat pangkat positif.</li>\r\n<li>&nbsp;Melakukan diskusi kelompok melalui gim edukasi Ruang Murid (eksloprasi petualangan Bilangan Eksponensial).</li>\r\n<li>Murid mempresentasikan hasil diskusi dan petualangan gim edukasi di Ruang Murid (eksplorasi petualangan bilangan eksponen) melalui pemanfaatan layar PID.</li>\r\n<li>Merefleksikan hasil pembelajaran.</li>\r\n<li>Menutup pembelajaran</li>\r\n</ol>',NULL,NULL,NULL,NULL,NULL,NULL,NULL,1,1,'2026-08-04 12:44:00','2026-08-04 12:44:57'),
