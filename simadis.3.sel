CREATE TABLE `pengembangan_sertifikat_templates` (
  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,
  `nama` varchar(191) DEFAULT NULL,
  `template_html` text DEFAULT NULL,
  `placeholder_positions` text DEFAULT NULL,
  `include_verification_code` tinyint(1) NOT NULL DEFAULT 1,
  `include_verification_qr` tinyint(1) NOT NULL DEFAULT 1,
  `include_barcode` tinyint(1) NOT NULL DEFAULT 0,
  `barcode_is_qr` tinyint(1) NOT NULL DEFAULT 1,
  `barcode_qr_size` int(11) DEFAULT NULL,
  `font_file` varchar(255) DEFAULT NULL,
  `editor_mode` varchar(191) DEFAULT NULL,
  `background_image` varchar(191) DEFAULT NULL,
  `output_format` varchar(191) DEFAULT 'pdf',
  `page_size` varchar(191) DEFAULT 'A4',
  `page_orientation` varchar(191) DEFAULT 'portrait',
  `created_at` timestamp NULL DEFAULT NULL,
  `updated_at` timestamp NULL DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=2 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
