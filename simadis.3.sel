/*!40000 ALTER TABLE `layanan_bk` DISABLE KEYS */;
INSERT INTO `layanan_bk` VALUES
(1,23,17,938,'2026-07-22','Layanan belajar','siswa menyakan cara belajar efektif.','siswa akan mencoba cara yang dibahas dengan guru BK','karena layanan diberikan melalui whatsapp, rencana yang akan datang, siswa tersebut akan di undang ke ruang BK untuk membahas lebih lanjut.','2026-07-22 01:27:43','2026-07-22 01:27:43'),
(2,25,17,1006,'2026-07-24','Layanan belajar','konsultasi mengenai pemilihan jurusan kuliah, kampus apa saja yang memiliki jurusan tersebut dan jalur masuk apa saja yang dibuka untuk ke jurusan tersebut.','siswa akan mencoba jalur masuk SNBP, SNBT, Simama dan mandiri untuk bisa masuk ke jurusan keperawatan.','untuk membahas keinginan siswa tersebut, orangtua akan di undang ke BK.','2026-07-23 19:31:46','2026-07-23 19:31:46'),
(3,25,17,1009,'2026-07-24','Layanan belajar','konsultasi mengenai pemilihan jurusan kuliah, kampus apa saja yang memiliki jurusan tersebut dan jalur masuk apa saja yang dibuka untuk ke jurusan tersebut.','siswa akan mencoba jalur masuk SNBP, SNBT, Simama dan mandiri untuk bisa masuk ke jurusan keperawatan.','untuk membahas keinginan siswa tersebut, orangtua akan di undang ke BK.','2026-07-23 19:32:27','2026-07-23 19:32:27'),
(4,23,17,931,'2026-07-24','Layanan belajar','cara memanage waktu','siswa di arahkan untuk memilih waktu yang efektif untuk belajar, dan membuat jadwal rutin di rumah, agar kegiatan harian bisa terjadwal dengan baik dan waktu yang digunakan lebih efektif.','akan dipantau seminggu setelah pembuatan jadwal.','2026-07-23 20:12:11','2026-07-23 20:12:11'),
(5,9,44,77,'2026-07-24','Bimbingan individual','Siswa di panggil untuk melakukan layanan bimbingan individual mempelajari sistem absen digital kelas','Siswa mempelajari sistem absen digital',NULL,'2026-07-24 00:38:24','2026-07-24 00:38:24'),
(6,1,42,NULL,'2026-07-27','Konseling individu','Layanan Dasar\r\nMengidentifikasi siswa kelas X.A yang berkebutuhan khusus','Terdapat siswa yang belum bisa membaca','Memberikan jadwal bimbel khusus membaca pada hari tertentu (fleksibel)','2026-07-26 20:50:09','2026-07-26 20:50:09'),
(7,9,44,NULL,'2026-07-28','Bimbingan klasikal','Guru bk menjelaskan mengenai kedisiplinan di sekolah','Tujuan dari bimbingan tsb agar siswa dapat mengetahui aturan yang ada di sekolah','Menerapkan konsekuensi jika ada yang melanggar','2026-07-27 18:53:28','2026-07-27 18:53:28'),
(8,1,42,NULL,'2026-07-28','Bimbingan Klasikal','Bahaya Bullying',NULL,NULL,'2026-07-28 19:19:56','2026-07-28 19:19:56'),
(9,26,17,1044,'2026-07-29','Layanan belajar','faiq datang ke ruang BK dengan perasaan takut, saat ditanya ada masalah apa. katanya saat dia di perpustaan, dan teman perempuannya sakit perut, merebahkan kepalanya di atas paha faiq, diktehui oleh guru. takut dilaporkan ke orangtua dan dikeluarkan dari rumah.','diberi pemahaman tentang hubungan dengan lawan jenis yang sehat.','akan dilihat kembali apakah faiq akan tetap berduaan dengan gina setiap selesai sekolah sampai sore atau tidak.','2026-07-29 19:00:15','2026-07-29 19:00:15'),
(10,26,17,1046,'2026-07-29','Layanan belajar','gina dilaporkan sedang tiduran di paha faiq di pojok perpustakaan sekolah. gina beralasan perutnya sakit dan tidak sengaja tiduran di paha faiq.\r\ndisisi lain gina dan faiq sering ditegur guru karena sering di lingkungan sekolah berduaan sampai jam 5 sore.','diberi bimbingan tentang pergaulan yang sehat dengan lawan jenis.','karena gina sering ditegur guru, jadi untuk ke depannya, gina akan lebih diperhatikan lagi.','2026-07-29 19:02:56','2026-07-29 19:02:56'),
(11,23,17,921,'2026-07-29','Layanan belajar','andini dilaporkan memposting video di akun tiktoknya, video tersebut berisi konten yang kurang pantas dengan menggunakan seragam sekolah.','andini diperingkatkan untuk terlebih dahulu menghapus postingannya dan diberi bimbingan tentang penggunaan medsos yang bijak.',NULL,'2026-07-29 19:04:51','2026-07-29 19:04:51'),
(12,1,42,NULL,'2026-07-30','Rapat wali siswa dengan wali kelas','Rapat wali siswa dengan wali kelas terkait perumusan kesepakatan tata tertib sekolah',NULL,NULL,'2026-07-29 23:47:16','2026-07-29 23:47:16'),
(13,9,44,NULL,'2026-07-30','Bimbingan klasikal','Screening inklusi','Ada 13 siswa yang masih kesulitan dalam hitungan dasar matematika','Pemantauan 2 minggu ke depan','2026-07-29 23:48:01','2026-07-29 23:48:01'),
(14,11,44,457,'2026-07-31','Konseling individual','Sudah 4 hari ini ghaffar tidak masuk sekolah tanpa keterangan, orang tua atau wali pun tidak datang pada saat jadwal pertemuan orang tua','Karna anak tsb tidak ada di sekolah, guru bk mencoba menghubungi nomor orang tua nya dan ternyata setiap harinya ghaffar berangkat sekolah bersama sepupu nya Bela kelas XI B 2, menurut neneknya ghaffar sempat cerita kalau di kelas nya ada yang mengejek','Kami menunggu sampai hari senin, jika senin tidak datang akan di home visit','2026-07-31 01:05:31','2026-07-31 01:05:31'),
(15,3,42,NULL,'2026-08-04','Bimbingan Klasikal','Layanan Orientasi sekolah',NULL,NULL,'2026-08-04 02:55:13','2026-08-04 02:55:13'),
(16,13,8,505,'2026-08-03','Konseling individual','Merasa tidak betah sekolah di SMAN 1 Pontang karena sebenarnya sejak awal ingin masuk SMK tapi orangtua berharap klien sekolah di SMAN.','Setelah dibicarakan dengan pihak keluarga maka diputuskan Abdullah pindah sekolah saja.',NULL,'2026-08-04 03:34:40','2026-08-04 03:34:40'),
(17,7,44,NULL,'2026-08-04','Bimbingan klasikal','Kedisiplinan absensi','Masih ada beberapa siswa yang sering terlambat setiap hari nya','Di berikan waktu selama 1 minggu ini untuk memperbaiki sikap','2026-08-04 04:51:40','2026-08-04 04:51:40'),
(18,11,44,NULL,'2026-08-04','Bimbingan klasikal','Layanan yang dilakukan adalah pemahaman edukasi mengenai dampak yang di timbulkan dari bercanda yang berlebihan','Hp sulton di kabarkan hilang dari jam 11  sampai 1 siang, di kelas tidak ada yang mau mengaku. Setelah di berikan pemahaman Ardi mengambilnya dari laci meja nya, menurutnya dia tidak merasa mengambil tapi hp itu ada di laci meja nya.',NULL,'2026-08-04 10:54:46','2026-08-04 10:54:46'),
(19,13,8,NULL,'2026-07-27','layanan klasikal','Melakukan perkenalan dan membuat kesepakatan kelas berkaitandengan kegiatan belajar di kelas dan kedisiplinan.',NULL,'Melakukan evaluasi berkaitan kehadiran dalam kegiatan belajar offline dan online.','2026-08-05 03:05:39','2026-08-05 03:05:39'),
(20,13,8,532,'2026-08-04','Konseling individual','siswa mengeluhkan kesulitan dalam mengikuti pembelajaran online terkendala jaringan internet. sehingga membuatnya dianggap alpa oleh guru.','mengikuti pembelajaran online dengan cara bergabung dengan teman.',NULL,'2026-08-05 03:10:06','2026-08-05 03:10:06'),
(21,17,8,NULL,'2026-07-28','layanan klasikal','Melakukan perkenalan sebagai guru BK yang akan membimbing kelas XI B1.',NULL,NULL,'2026-08-05 03:19:57','2026-08-05 03:19:57'),
(22,18,8,NULL,'2026-07-28','layanan klasikal','Melakukan koordinasi dengan wali kelas berkaitan dengan tingkat khadiran siswa dalam kegiatan offline dan online.',NULL,NULL,'2026-08-05 03:40:33','2026-08-05 03:40:33'),
(23,23,17,945,'2026-08-05','Layanan belajar','Nuwaf merasa tidak nyaman tinggal di rumah bersama ibu dan ayah tirinya, ibu dan ayahnya sudah lama bercerai, dan yang sekarang tinggal dengan nuwaf adalah ayah tiri (suami ketiga ibunya). nuwaf jarang ngobrol dengan ayah tirinya tersebut, sedangkan ayah kandungnya sudah berumah tangga dan memiliki anak 3, nuwaf anak tunggal dari ibunya. nuwaf memiliki cita-cita kuliah di teknik pertambangan, akan tetapi ragu dengan kemampuan yang dimilikinya.','diberikan penguatan agar nuwaf memiliki kepercayaan diri untuk meraih cita-citanya, salah satu caranya dengan mecoba untuk membahas rencana tersebut dengan orangtuanya, agar ada dukungan dari keluarga.','hasil dari obrolan dengan orangtuanya akan di bahas di pertemuan berikutnya.','2026-08-05 04:48:14','2026-08-05 04:48:14'),
(24,13,8,NULL,'2026-08-05','layanan klasikal','Melakukan layanan bimbingan dalam bidang belajar berkaitan dengan kegiatan pembelajaran online.','ada beberapa siswa yang tidak aktif dalam kegiatan pembelajaran online.','pemanggilan siswa untuk dilakukan layanan bimbingan.','2026-08-05 07:54:44','2026-08-05 07:54:44'),
(25,12,8,NULL,'2026-08-05','konsultasi dengan wali kelas','Konsultasi dengan wali kelas berkaitan tingkat kehadiran siswa di kelas online.',NULL,NULL,'2026-08-05 08:24:42','2026-08-05 08:24:42'),
(26,9,44,NULL,'2026-08-06','Bimbingan klasikal','Menjelaskan asesmen riasec',NULL,'Akan di lakukan asesmen arah minat','2026-08-06 06:30:23','2026-08-06 06:30:23'),
(27,12,8,469,'2026-08-06','Konsultasi dengan orangtua','Andri sering tidak hadir dalam kegiatan belajar online dengan alasan bangun kesiangan. perilaku tersebut sering terjadi juga ketika klien kelaS x. .Pada hari ini oranmgtua klien datang ke sekolah memenuhi undangan dari BK. Orangtua berharap klien mampu merubah perilakunya dan memiliki kesadaran untuk semangat belajar. Klien adalah anak pertama dari dua bersaudara. ibu klien seorang guru dan ayahnya bekerja di kantor dinas provinsi. Sehari hari klien l3ebih banyak menghabiskan waktu di rumah neneknya bahkan lebih sering tidur di rumah nenek dibandingkan dengan di rumah orangtuanya. Di sekolah klien merasa mendapat kelas yang kurang nyaman.','Klien berjanji untuk lebih nsemangat belajar dan hadir dalam kegiatan belajar di sekolah.\r\nwali kelas akan membantu klien untuk beradaptasi dengan lingkungan yang baru  dengan teman teman yang baru.',NULL,'2026-08-06 08:02:00','2026-08-06 08:02:00');
/*!40000 ALTER TABLE `layanan_bk` ENABLE KEYS */;
UNLOCK TABLES;
COMMIT;
SET AUTOCOMMIT=@OLD_AUTOCOMMIT;

