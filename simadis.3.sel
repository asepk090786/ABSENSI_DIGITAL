ull,null,null,[[2,0,0,21]]],null,&quot;24d3ed3b-fde1-4efb-a6ed-2b3416731525&quot;]]--></span> untuk kajian teks Q.S. Al-Qasas/28: 85 dan Q.S. Al-Baqarah/2: 143<!--TgQPHd|||[]--></span><!--TgQPHd|||[]--></div>\r\n<div class=\"\" data-bfc=\"\" data-ved=\"2ahUKEwiblYH60IuWAxUQkuEIHSMxBZQQi4wTegoIAggACAAIFBAJ\" data-hveid=\"CAIIAAgACBQQCQ\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\"><span class=\"iNqyIf\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\"><strong class=\"rQesXe MPyX\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 700; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\">Bahan presentasi<!--TgQPHd|||[]--></strong>: Paparan visual materi di <span class=\"\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\"><a class=\"H23r4e\" href=\"https://www.slideshare.net/slideshow/pai-kelas-12-sma-cinta-tanah-air-dan-moderasi-dalam-beragama/275330985\" target=\"_blank\" rel=\"noopener\" data-ved=\"2ahUKEwiblYH60IuWAxUQkuEIHSMxBZQQy_kOegoIAggACAAIFBAL\" data-hveid=\"CAIIAAgACBQQCw\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 500; margin: 0px; text-decoration: underline 1px rgb(26, 13, 171); border-bottom: 0px rgb(26, 13, 171);\">SlideShare PAI Kelas 12</a><!--TgQPHd|||[[&quot;https://www.slideshare.net/slideshow/pai-kelas-12-sma-cinta-tanah-air-dan-moderasi-dalam-beragama/275330985&quot;,null,null,[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[{&quot;1218&quot;:[16]}]],16,null,&quot;PAI Kelas 12 SMA - Cinta Tanah Air dan Moderasi dalam Beragama&quot;,&quot;Cinta tanah air dipandang sebagai bagian dari iman dan diharapkan dapat menumbuhkan sikap nasionalisme serta menjaga persatuan bangsa. Selain itu, moderasi beragama diartikan sebagai sikap seimbang yang menghindari ekstremisme, dengan tujuan menciptakan kehidupan yang damai dan harmonis di masyarakat.&quot;,&quot;https://encrypted-tbn0.gstatic.com/images?q\\u003dtbn:ANd9GcQr75-5jVwxwHRKpcb_Pg1lBO-Zr-jKfsuTvpAI-q7_CG3YQQIc7NGSS14IbkIRn7c3Ze1Dt3h2lmdbhtA&quot;,&quot;Slideshare&quot;,&quot;https://encrypted-tbn0.gstatic.com/faviconV2?url\\u003dhttps://www.slideshare.net\\u0026client\\u003dAIM\\u0026size\\u003d128\\u0026type\\u003dFAVICON\\u0026fallback_opts\\u003dTYPE,SIZE,URL&quot;,[[1786006571338395,149000720,2483368227],null,null,null,null,[[2,0,0,22]]],null,&quot;a8585d18-fb51-4a8b-8714-86182899cba6&quot;]]--></span><!--TgQPHd|||[]--></span><!--TgQPHd|||[]--></div>\r\n<div class=\"\" data-bfc=\"\" data-ved=\"2ahUKEwiblYH60IuWAxUQkuEIHSMxBZQQi4wTegoIAggACAAIFBAM\" data-hveid=\"CAIIAAgACBQQDA\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\"><span class=\"iNqyIf\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\"><strong class=\"rQesXe MPyX\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 700; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\">Video pengantar<!--TgQPHd|||[]--></strong>: Penjelasan konsep di <span class=\"\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\"><a class=\"H23r4e\" href=\"https://www.youtube.com/watch?v=ZSNnQiccNUU\" target=\"_blank\" rel=\"noopener\" data-ved=\"2ahUKEwiblYH60IuWAxUQkuEIHSMxBZQQy_kOegoIAggACAAIFBAO\" data-hveid=\"CAIIAAgACBQQDg\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 500; margin: 0px; text-decoration: underline 1px rgb(26, 13, 171); border-bottom: 0px rgb(26, 13, 171);\">YouTube PAI Kelas 12</a></span></span></div>','<p><span data-subtree=\"aimfl,mfl\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\">Penilaian pembelajaran materi Pendidikan Agama Islam (PAI) kelas 12 tentang cinta tanah air dan moderasi beragama </span><mark class=\"HxTRcb\" data-sfc-root=\"ep\" data-wiz-uids=\"s4uUAe_k\" data-ved=\"2ahUKEwiX3byL0YuWAxWBlOEIHbHrLzQQuJAPegoIAggACAAIBxAB\" data-complete=\"true\" data-sfc-inited=\"2\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 500; margin: 0px; text-decoration: none; border-bottom: 0px rgb(0, 29, 53);\"><!--qkimaf s4uUAe_j/HugV6--><!--cqw1tb s4uUAe_j/HugV6-->mencakup tiga ranah: asesmen diagnostik, formatif, dan sumatif<!--TgQPHd|||[]--></mark>. Aspek yang dinilai meliputi pemahaman konsep, pengamalan sikap nasionalisme-toleransi, serta keterampilan menyajikan gagasan</p>','3 X 45 Menit','<p><span data-subtree=\"aimfl,mfl\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\">Praktik pedagogis untuk materi Pendidikan Agama Islam (PAI) kelas 12 tentang cinta tanah air dan moderasi beragama </span><mark class=\"HxTRcb\" data-sfc-root=\"ep\" data-wiz-uids=\"MdPmjb_1c\" data-ved=\"2ahUKEwicxNaj0IuWAxUaieEIHQO4MzEQuJAPegoIAggACAAIEBAB\" data-complete=\"true\" data-sfc-inited=\"2\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 500; margin: 0px; text-decoration: none; border-bottom: 0px rgb(0, 29, 53);\"><!--qkimaf MdPmjb_1b/HugV6--><!--cqw1tb MdPmjb_1b/HugV6-->menggunakan model berpusat pada siswa seperti <em class=\"eujQNb\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 500; margin: 0px; text-decoration: none; border-bottom: 0px rgb(0, 29, 53);\">Discovery Learning<!--TgQPHd|||[]--></em>, <em class=\"eujQNb\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 500; margin: 0px; text-decoration: none; border-bottom: 0px rgb(0, 29, 53);\">Project-Based Learning<!--TgQPHd|||[]--></em>, dan studi kasus<!--TgQPHd|||[]--></mark>. Guru memakai metode diskusi kelompok, analisis teks atau video, serta refleksi nilai agar siswa mampu bersikap adil, toleran, dan nasionalis</p>','<p><span data-subtree=\"aimfl,mfl\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\">Lingkungan pembelajaran materi Pendidikan Agama Islam (PAI) kelas 12 tentang cinta tanah air dan moderasi beragama </span><mark class=\"HxTRcb\" data-sfc-root=\"ep\" data-wiz-uids=\"XXqTee_1c\" data-ved=\"2ahUKEwj1tKq00IuWAxXTgeEIHc-aOiEQuJAPegoIAggACAAIEBAB\" data-complete=\"true\" data-sfc-inited=\"2\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 500; margin: 0px; text-decoration: none; border-bottom: 0px rgb(0, 29, 53);\"><!--qkimaf XXqTee_1b/HugV6--><!--cqw1tb XXqTee_1b/HugV6-->dibangun melalui iklim sekolah yang inklusif, dialog interaktif, keteladanan guru, serta pembiasaan sikap toleran dan nasionalisme dalam kehidupan sehari-hari</mark></p>','<p><span data-subtree=\"aimfl,mfl\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\">Pemanfaatan media digital dalam materi Pendidikan Agama Islam (PAI) kelas 12 tentang </span><strong class=\"rQesXe MPyX\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 700; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\">cinta tanah air<!--TgQPHd|||[]--></strong> dan <strong class=\"rQesXe MPyX\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 700; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\">moderasi beragama<!--TgQPHd|||[]--></strong> dapat dilakukan melalui <mark class=\"HxTRcb\" data-sfc-root=\"ep\" data-wiz-uids=\"Yl6v7_1e\" data-ved=\"2ahUKEwiOtdTJ0IuWAxX-gOEIHRkII18QuJAPegoIAggACAAIDhAB\" data-complete=\"true\" data-sfc-inited=\"2\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 500; margin: 0px; text-decoration: none; border-bottom: 0px rgb(0, 29, 53);\"><!--qkimaf Yl6v7_1d/HugV6--><!--cqw1tb Yl6v7_1d/HugV6-->pembuatan konten video kolaboratif, diskusi berbasis e-learning, pemanfaatan infografis toleransi, serta kampanye damai di media sosial untuk membangun sikap nasionalisme dan anti-kekerasan</mark></p>','<p><span data-subtree=\"aimfl,mfl\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\">Pengalaman belajar materi Pendidikan Agama Islam (PAI) kelas 12 tentang cinta tanah air dan moderasi beragama </span><mark class=\"HxTRcb\" data-sfc-root=\"ep\" data-wiz-uids=\"mrNQEc_k\" data-ved=\"2ahUKEwimzePc0IuWAxX1guEIHeBiGZcQuJAPegoIAggACAAIBxAB\" data-complete=\"true\" data-sfc-inited=\"2\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 500; margin: 0px; text-decoration: none; border-bottom: 0px rgb(0, 29, 53);\"><!--qkimaf mrNQEc_j/HugV6--><!--cqw1tb mrNQEc_j/HugV6-->memberikan pemahaman mendalam bahwa nasionalisme adalah bagian dari iman (<em class=\"eujQNb\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 500; margin: 0px; text-decoration: none; border-bottom: 0px rgb(0, 29, 53);\">hubbul wathan minal iman<!--TgQPHd|||[]--></em>), serta mengajarkan sikap tengah (<em class=\"eujQNb\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 500; margin: 0px; text-decoration: none; border-bottom: 0px rgb(0, 29, 53);\">wasathiyah<!--TgQPHd|||[]--></em>) yang adil, toleran, dan rukun dalam keberagaman</mark></p>','<p><span data-subtree=\"aimfl,mfl\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\">Refleksi pembelajaran materi PAI kelas 12 tentang cinta tanah air dan moderasi beragama </span><mark class=\"HxTRcb\" data-sfc-root=\"ep\" data-wiz-uids=\"gCFoSd_k\" data-ved=\"2ahUKEwi_ouLt0IuWAxU3OS4FHSgtD80QuJAPegoIAggACAAIBxAB\" data-complete=\"true\" data-sfc-inited=\"2\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 500; margin: 0px; text-decoration: none; border-bottom: 0px rgb(0, 29, 53);\"><!--qkimaf gCFoSd_j/HugV6--><!--cqw1tb gCFoSd_j/HugV6-->menunjukkan pentingnya menanamkan sikap nasionalisme yang selaras dengan nilai agama<!--TgQPHd|||[]--></mark>. Siswa belajar bahwa menjaga keutuhan bangsa dan bersikap adil, toleran, serta tidak ekstrem adalah bagian dari pengamalan iman dalam kehidupan majemuk</p>',NULL,NULL,'published',NULL,NULL,'2026-08-06 08:57:19','2026-08-06 08:57:19'),
(113,7,1,NULL,23,NULL,'cinta tanah air dan moderasi beragama','<p><span data-subtree=\"aimfl,mfl\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\">Capaian Pembelajaran (CP) materi </span><strong class=\"rQesXe MPyX\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 700; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\">Cinta Tanah Air dan Moderasi Beragama<!--TgQPHd|||[]--></strong> untuk mata pelajaran PAI Kelas 12 (Fase F) menuntut peserta didik <mark class=\"HxTRcb\" data-sfc-root=\"ep\" data-wiz-uids=\"aprLqe_1d\" data-ved=\"2ahUKEwik1eG8z4uWAxXNjuEIHd10JjsQuJAPegoIAggACAAIDxAB\" data-complete=\"true\" data-sfc-inited=\"2\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 500; margin: 0px; text-decoration: none; border-bottom: 0px rgb(0, 29, 53);\"><!--qkimaf aprLqe_1c/HugV6--><!--cqw1tb aprLqe_1c/HugV6-->mampu menganalisis dalil Al-Qur\'an dan Hadis, menginternalisasi nilai-nilai kebangsaan, serta menerapkan sikap toleran dan seimbang dalam kehidupan bermasyarakat yang majemuk.</mark></p>\r\n<div class=\"otQkpb\" role=\"heading\" aria-level=\"3\" data-animation-nesting=\"\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 20px; font-weight: 600; margin: 24px 0px 12px; text-decoration: none; border-bottom: 0px rgb(0, 29, 53);\">Target Capaian Pembelajaran<!--TgQPHd|||[]--></div>\r\n<div class=\"\" data-bfc=\"\" data-ved=\"2ahUKEwik1eG8z4uWAxXNjuEIHd10JjsQi4wTegoIAggACAAIExAB\" data-hveid=\"CAIIAAgACBMQAQ\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\"><span class=\"iNqyIf\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\"><strong class=\"rQesXe MPyX\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 700; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\">Menganalisis Dalil:<!--TgQPHd|||[]--></strong> Peserta didik mampu membaca, menterjemahkan, dan menganalisis ayat Al-Qur\'an (seperti Q.S. Al-Qasas/28: 85 dan Q.S. Al-Baqarah/2: 143) serta Hadis terkait konsep cinta tanah air dan moderasi beragama.</span><!--TgQPHd|||[]--></div>\r\n<div class=\"\" data-bfc=\"\" data-ved=\"2ahUKEwik1eG8z4uWAxXNjuEIHd10JjsQi4wTegoIAggACAAIExAH\" data-hveid=\"CAIIAAgACBMQBw\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\"><span class=\"iNqyIf\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\"><strong class=\"rQesXe MPyX\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 700; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\">Memahami Konsep:<!--TgQPHd|||[]--></strong> Peserta didik menguasai makna konseptual cinta tanah air sebagai bagian dari iman (<em class=\"eujQNb\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\">hubbul wathan minal iman<!--TgQPHd|||[]--></em>) dan prinsip moderasi beragama (<em class=\"eujQNb\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\">wasathiyah<!--TgQPHd|||[]--></em>).</span><!--TgQPHd|||[]--></div>\r\n<div class=\"\" data-bfc=\"\" data-ved=\"2ahUKEwik1eG8z4uWAxXNjuEIHd10JjsQi4wTegoIAggACAAIExAN\" data-hveid=\"CAIIAAgACBMQDQ\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\"><span class=\"iNqyIf\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\"><strong class=\"rQesXe MPyX\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 700; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\">Internalisasi Nilai:<!--TgQPHd|||[]--></strong> Peserta didik mampu mengidentifikasi empat pilar utama moderasi beragama, yaitu komitmen kebangsaan, toleransi, anti-kekerasan, dan akomodasi budaya loka</span></div>','<p><span data-subtree=\"aimfl,mfl\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\">Tujuan pembelajaran materi Pendidikan Agama Islam (PAI) kelas 12 tentang </span><strong class=\"rQesXe MPyX\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 700; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\">cinta tanah air<!--TgQPHd|||[]--></strong> dan <strong class=\"rQesXe MPyX\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 700; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\">moderasi beragama<!--TgQPHd|||[]--></strong> adalah <mark class=\"HxTRcb\" data-sfc-root=\"ep\" data-wiz-uids=\"mxFoT_m\" data-ved=\"2ahUKEwiWlJTpz4uWAxULgeEIHQeIPY4QuJAPegoIAggACAAICxAB\" data-complete=\"true\" data-sfc-inited=\"2\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 500; margin: 0px; text-decoration: none; border-bottom: 0px rgb(0, 29, 53);\"><!--qkimaf mxFoT_l/HugV6--><!--cqw1tb mxFoT_l/HugV6-->agar siswa mampu memahami konsep nasionalisme dan sikap beragama yang seimbang, menghargai perbedaan, menolak sikap ekstrem, serta mengamalkan nilai toleransi dan kerukunan dalam kehidupan berbangsa</mark></p>','<div class=\"n6owBd awi2gc\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-hveid=\"CAIIAAgACA8QAA\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 12px 0px 16px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\"><span data-subtree=\"aimfl,mfl\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\">Metode pembelajaran materi Pendidikan Agama Islam (PAI) kelas 12 tentang cinta tanah air dan moderasi beragama </span><mark class=\"HxTRcb\" data-sfc-root=\"ep\" data-wiz-uids=\"BezPqd_1c\" data-ved=\"2ahUKEwiq5dH7z4uWAxUEj-EIHWZmMJ0QuJAPegoIAggACAAIDxAB\" data-complete=\"true\" data-sfc-inited=\"2\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 500; margin: 0px; text-decoration: none; border-bottom: 0px rgb(0, 29, 53);\"><!--qkimaf BezPqd_1b/HugV6--><!--cqw1tb BezPqd_1b/HugV6-->menggunakan pendekatan interaktif, kontekstual, dan afektif seperti <em class=\"eujQNb\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 500; margin: 0px; text-decoration: none; border-bottom: 0px rgb(0, 29, 53);\">Problem Based Learning<!--TgQPHd|||[]--></em>, diskusi kelompok, pemutaran video, dan penugasan proyek sosial<!--TgQPHd|||[]--></mark>. Metode ini bertujuan membentuk sikap toleran, adil, serta nasionalis.<!--TgQPHd|||[]--></div>\r\n<div class=\"Fsg96\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-sfc-inited=\"2\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\"><!--TgQPHd|||[]--></div>\r\n<div class=\"otQkpb\" role=\"heading\" aria-level=\"3\" data-animation-nesting=\"\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 20px; font-weight: 600; margin: 24px 0px 12px; text-decoration: none; border-bottom: 0px rgb(0, 29, 53);\">Metode Pembelajaran yang Digunakan<!--TgQPHd|||[]--></div>\r\n<div class=\"\" data-bfc=\"\" data-ved=\"2ahUKEwiq5dH7z4uWAxUEj-EIHWZmMJ0Qi4wTegoIAggACAAIEhAB\" data-hveid=\"CAIIAAgACBIQAQ\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\"><span class=\"iNqyIf\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\"><strong class=\"rQesXe MPyX\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 700; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\">Contextual Teaching and Learning (CTL):<!--TgQPHd|||[]--></strong> Mengaitkan materi cinta tanah air dengan isu nyata kebangsaan dan keragaman di Indonesia saat ini.<!--TgQPHd|||[]--></span><!--TgQPHd|||[]--></div>\r\n<div class=\"\" data-bfc=\"\" data-ved=\"2ahUKEwiq5dH7z4uWAxUEj-EIHWZmMJ0Qi4wTegoIAggACAAIEhAD\" data-hveid=\"CAIIAAgACBIQAw\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\"><span class=\"iNqyIf\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\"><strong class=\"rQesXe MPyX\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 700; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\">Problem Based Learning (PBL):<!--TgQPHd|||[]--></strong> Siswa memecahkan kasus nyata konflik radikalisme atau intoleransi dalam bentuk studi kasus kelompok.<!--TgQPHd|||[]--></span><!--TgQPHd|||[]--></div>\r\n<div class=\"\" data-bfc=\"\" data-ved=\"2ahUKEwiq5dH7z4uWAxUEj-EIHWZmMJ0Qi4wTegoIAggACAAIEhAF\" data-hveid=\"CAIIAAgACBIQBQ\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\"><span class=\"iNqyIf\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\"><strong class=\"rQesXe MPyX\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 700; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\">Role Playing (Bermain Peran):<!--TgQPHd|||[]--></strong> Mensimulasikan dialog lintas budaya atau cara mengatasi perbedaan pendapat secara bijak dan moderat.<!--TgQPHd|||[]--></span><!--TgQPHd|||[]--></div>\r\n<div class=\"\" data-bfc=\"\" data-ved=\"2ahUKEwiq5dH7z4uWAxUEj-EIHWZmMJ0Qi4wTegoIAggACAAIEhAH\" data-hveid=\"CAIIAAgACBIQBw\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\"><span class=\"iNqyIf\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\"><strong class=\"rQesXe MPyX\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 700; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\">Metode Keteladanan dan Pembiasaan:<!--TgQPHd|||[]--></strong> Guru memberi contoh sikap santun dan menghargai perbedaan di lingkungan sekolah</span></div>','<p><span data-subtree=\"aimfl,mfl\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\">Media pembelajaran materi Pendidikan Agama Islam (PAI) kelas 12 tentang </span><strong class=\"rQesXe MPyX\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 700; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\">cinta tanah air dan moderasi beragama<!--TgQPHd|||[]--></strong> mencakup <mark class=\"HxTRcb\" data-sfc-root=\"ep\" data-wiz-uids=\"vauqz_1d\" data-ved=\"2ahUKEwiOm9iO0IuWAxXqDy4FHR6lFg4QuJAPegoIAggACAAIDRAB\" data-sfc-inited=\"2\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 500; margin: 0px; text-decoration: none; border-bottom: 0px rgb(0, 29, 53);\"><!--qkimaf vauqz_1c/HugV6--><!--cqw1tb vauqz_1c/HugV6-->penggunaan <strong class=\"rQesXe MPyX\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 700; margin: 0px; text-decoration: none; border-bottom: 0px rgb(0, 29, 53);\">modul ajar berbasis teks<!--TgQPHd|||[]--></strong>, <strong class=\"rQesXe MPyX\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 700; margin: 0px; text-decoration: none; border-bottom: 0px rgb(0, 29, 53);\">tayangan video kajian ayat Al-Qur\'an (seperti Q.S. Al-Baqarah: 143)<!--TgQPHd|||[]--></strong>, <strong class=\"rQesXe MPyX\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 700; margin: 0px; text-decoration: none; border-bottom: 0px rgb(0, 29, 53);\">media interaktif berbasis salindia (slide)<!--TgQPHd|||[]--></strong>, serta <strong class=\"rQesXe MPyX\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 700; margin: 0px; text-decoration: none; border-bottom: 0px rgb(0, 29, 53);\">studi kasus toleransi dan komitmen kebangsaan</strong></mark></p>','<div class=\"n6owBd awi2gc\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-hveid=\"CAIIAAgACBAQAA\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 12px 0px 16px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\"><span data-subtree=\"aimfl,mfl\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\">Sumber belajar materi Pendidikan Agama Islam (PAI) kelas 12 tentang cinta tanah air dan moderasi beragama mencakup </span><mark class=\"HxTRcb\" data-sfc-root=\"ep\" data-wiz-uids=\"uc7Ijf_1c\" data-ved=\"2ahUKEwiblYH60IuWAxUQkuEIHSMxBZQQuJAPegoIAggACAAIEBAB\" data-complete=\"true\" data-sfc-inited=\"2\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 500; margin: 0px; text-decoration: none; border-bottom: 0px rgb(0, 29, 53);\"><!--qkimaf uc7Ijf_1b/HugV6--><!--cqw1tb uc7Ijf_1b/HugV6-->Buku Paket PAI Kelas 12 Kurikulum Merdeka, Modul Ajar RPP, materi digital dari situs pendukung, serta video pembelajaran interaktif yang membahas dalil Al-Qur\'an seperti Q.S. Al-Baqarah/2: 143<!--TgQPHd|||[]--></mark>. [<a href=\"https://www.belajarpai.com/wp-content/uploads/2023/09/BAB-6_Cinta-Tanah-Air-dan-Moderasi-Beragama_BS-12.pdf\">1</a>, <a href=\"https://id.scribd.com/document/937419119/Modul-Ajar-Cinta-Tanah-Air-dan-Moderasi-Beragama\">2</a>, <a href=\"https://sman1gomoker.sch.id/rpp/uploads/Said%20Wahid_PAI_XII_Bab%206.pdf\">3</a>, <a href=\"https://www.youtube.com/watch?v=ZSNnQiccNUU&amp;t=814\">4</a>, <a href=\"https://umj.ac.id/opini/moderasi-beragama-tanpa-makna/\">5</a>]<!--TgQPHd|||[]--></div>\r\n<div class=\"Fsg96\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-sfc-inited=\"2\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\"><!--TgQPHd|||[]--></div>\r\n<div class=\"otQkpb\" role=\"heading\" aria-level=\"3\" data-animation-nesting=\"\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 20px; font-weight: 600; margin: 24px 0px 12px; text-decoration: none; border-bottom: 0px rgb(0, 29, 53);\">Rincian Sumber Belajar<!--TgQPHd|||[]--></div>\r\n<div class=\"\" data-bfc=\"\" data-ved=\"2ahUKEwiblYH60IuWAxUQkuEIHSMxBZQQi4wTegoIAggACAAIFBAB\" data-hveid=\"CAIIAAgACBQQAQ\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\"><span class=\"iNqyIf\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\"><strong class=\"rQesXe MPyX\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 700; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\">Buku teks utama<!--TgQPHd|||[]--></strong>: Buku Paket Pendidikan Agama Islam dan Budi Pekerti Kelas XII (Bab tentang Cinta Tanah Air dan Moderasi Beragama)<!--TgQPHd|||[]--></span><!--TgQPHd|||[]--></div>\r\n<div class=\"\" data-bfc=\"\" data-ved=\"2ahUKEwiblYH60IuWAxUQkuEIHSMxBZQQi4wTegoIAggACAAIFBAD\" data-hveid=\"CAIIAAgACBQQAw\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\"><span class=\"iNqyIf\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\"><strong class=\"rQesXe MPyX\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 700; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\">Perangkat ajar guru<!--TgQPHd|||[]--></strong>: <span class=\"\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\"><a class=\"H23r4e\" href=\"https://sman1gomoker.sch.id/rpp/uploads/Indri%20Cahyani%20PAI-BP%20XII_Cinta%20Tanah%20Air%20dan%20Moderasi%20Beragama.pdf\" target=\"_blank\" rel=\"noopener\" data-ved=\"2ahUKEwiblYH60IuWAxUQkuEIHSMxBZQQy_kOegoIAggACAAIFBAF\" data-hveid=\"CAIIAAgACBQQBQ\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 500; margin: 0px; text-decoration: underline 1px rgb(26, 13, 171); border-bottom: 0px rgb(26, 13, 171);\">Modul Ajar PAI Kelas 12 SMAN 1 Gomoker</a><!--TgQPHd|||[[&quot;https://sman1gomoker.sch.id/rpp/uploads/Indri%20Cahyani%20PAI-BP%20XII_Cinta%20Tanah%20Air%20dan%20Moderasi%20Beragama.pdf&quot;,null,null,[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,[{&quot;1218&quot;:[16]}]],16,null,&quot;PENDIDIKAN AGAMA ISLAM DAN BUDI PEKERTI BAB&quot;,&quot;Struktur materi berjenjang, dimulai dari dasar- dasar cinta tanah air dalam Islam, kemudian diperdalam dengan konsep moderasi beragama, dan diakhiri dengan ...&quot;,null,&quot;SMAN 1 Gondang Mojokerto&quot;,&quot;https://encrypted-tbn2.gstatic.com/faviconV2?url\\u003dhttps://sman1gomoker.sch.id\\u0026client\\u003dAIM\\u0026size\\u003d128\\u0026type\\u003dFAVICON\\u0026fallback_opts\\u003dTYPE,SIZE,URL&quot;,[[1786006571338395,149000720,2483368227],null,null,null,null,[[2,0,0,19]]],null,&quot;f90683ef-98e1-4a29-b09e-d0bd35da832e&quot;]]--></span> yang memuat RPP dan tujuan pembelajaran<!--TgQPHd|||[]--></span><!--TgQPHd|||[]--></div>\r\n<div class=\"\" data-bfc=\"\" data-ved=\"2ahUKEwiblYH60IuWAxUQkuEIHSMxBZQQi4wTegoIAggACAAIFBAG\" data-hveid=\"CAIIAAgACBQQBg\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 10);\"><span class=\"iNqyIf\" data-sfc-cp=\"\" data-sfc-root=\"ep\" data-complete=\"true\" data-copy-service-computed-style=\"font-family: &quot;Google Sans&quot;, Arial, sans-serif; font-size: 16px; font-weight: 400; margin: 0px; text-decoration: none; border-bottom: 0px rgb(10, 10, 1