DROP TABLE IF EXISTS `pengembangan_sertifikats`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!40101 SET character_set_client = utf8mb4 */;
CREATE TABLE `pengembangan_sertifikats` (
  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,
  `pengembangan_id` bigint(20) unsigned NOT NULL,
  `peserta_type` varchar(191) NOT NULL,
  `peserta_id` bigint(20) unsigned DEFAULT NULL,
  `peserta_name` varchar(191) DEFAULT NULL,
  `instansi` varchar(191) DEFAULT NULL,
  `file_path` varchar(191) DEFAULT NULL,
  `template_id` bigint(20) unsigned DEFAULT NULL,
  `is_visible` tinyint(1) NOT NULL DEFAULT 1,
  `bukti_dukung_daftar_hadir` varchar(191) DEFAULT NULL,
  `bukti_dukung_dokumentasi` longtext CHARACTER SET utf8mb4 COLLATE utf8mb4_bin DEFAULT NULL CHECK (json_valid(`bukti_dukung_dokumentasi`)),
  `bukti_dukung_materi` longtext CHARACTER SET utf8mb4 COLLATE utf8mb4_bin DEFAULT NULL CHECK (json_valid(`bukti_dukung_materi`)),
  `barcode` varchar(191) NOT NULL,
  `nomor_sertifikat` varchar(191) DEFAULT NULL,
  `verified_at` timestamp NULL DEFAULT NULL,
  `created_at` timestamp NULL DEFAULT NULL,
  `updated_at` timestamp NULL DEFAULT NULL,
  PRIMARY KEY (`id`),
  UNIQUE KEY `pengembangan_sertifikats_barcode_unique` (`barcode`),
  KEY `pengembangan_sertifikats_pengembangan_id_foreign` (`pengembangan_id`),
  KEY `pengembangan_sertifikats_template_id_foreign` (`template_id`),
  CONSTRAINT `pengembangan_sertifikats_pengembangan_id_foreign` FOREIGN KEY (`pengembangan_id`) REFERENCES `pengembangan_diri` (`id`) ON DELETE CASCADE,
  CONSTRAINT `pengembangan_sertifikats_template_id_foreign` FOREIGN KEY (`template_id`) REFERENCES `pengembangan_sertifikat_templates` (`id`) ON DELETE SET NULL
) ENGINE=InnoDB AUTO_INCREMENT=58 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
