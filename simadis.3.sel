(2269,14,41,'kbm',20,'2026-08-07','<p>Melakukan apersepsi materi pertemuan sebelumnya yaitu bentuk umum polinomial dan ciri bukan polinomial.</p>\r\n<p>Melakukan diskusi secara virtual dari masalah operasi polinomial yaitu operasi penjumlahan, pengurangan dan</p>\r\n<p>perkalian polinomial.</p>\r\n<p>Perwakilan murid mempresentasikan hasil penyelesaian masalah operasi pengurangan dan perkalian fungsi</p>\r\n<p>polinomial.</p>\r\n<p>Merefleksikan bersama murid lainnya untuk bisa memberikan feedback hasil presentasi temannya.</p>\r\n<p>Merefleksikan pembelajaran bersama.</p>\r\n<p>Menutup pembelajaran dgn doa.</p>',NULL,NULL,NULL,NULL,NULL,NULL,NULL,1,1,'2026-08-07 13:04:28','2026-08-07 13:04:28'),
(2270,14,41,'kbm',25,'2026-08-07','<p>Melakukan apersepsi materi pertemuan sebelumnya yaitu bentuk umum polinomial dan ciri bukan polinomial.</p>\r\n<p>Melakukan diskusi secara virtual dari masalah operasi polinomial yaitu operasi penjumlahan, pengurangan dan</p>\r\n<p>perkalian polinomial.</p>\r\n<p>Perwakilan murid mempresentasikan hasil penyelesaian masalah operasi pengurangan dan perkalian fungsi</p>\r\n<p>polinomial.</p>\r\n<p>Merefleksikan bersama murid lainnya untuk bisa memberikan feedback hasil presentasi temannya.</p>\r\n<p>Merefleksikan pembelajaran bersama.</p>\r\n<p>Menutup pembelajaran dgn doa.</p>',NULL,NULL,NULL,NULL,NULL,NULL,NULL,1,1,'2026-08-07 13:04:28','2026-08-07 13:04:28');
