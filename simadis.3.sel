(6,8,'.........',100.00,'Peserta didik memiliki kemampuan untuk merespon isu-isu global dan berperan aktif dalam memberikan penyelesaian masalah. Kemampuan tersebut antara lain mengidentifikasi, mengajukan gagasan, merancang solusi, mengambil keputusan, dan mengkomunikasikan dalam bentuk projek sederhana atau simulasi visual menggunakan aplikasi teknologi yang tersedia terkait dengan Hakikat dan Peran Ilmu Kimia',NULL,NULL,NULL,'2026-07-29 19:09:23','2026-07-30 19:43:34'),
(7,7,'Asesmen kognitif',100.00,NULL,NULL,NULL,NULL,'2026-07-30 18:09:38','2026-07-30 18:09:38'),
(8,9,'Asesmen Formatif',100.00,NULL,NULL,NULL,NULL,'2026-08-03 02:27:33','2026-08-03 02:27:33');
