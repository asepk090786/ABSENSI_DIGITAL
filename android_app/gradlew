#!/usr/bin/env sh

##############################################################################
##
##  Gradle start up script for POSIX generated by Gradle.
##
##  This script is intentionally generated for use by the project.
##  It is not intended to be used manually.
##
##  This program is not intended to be used as part of a full application installation.
##
##  This script is not intended to be used as part of the full application installation.
##
##  This script is not intended to be used as part of a full application installation.
##
##  This file is generated by the Gradle wrapper script generation.
##
##  To run the project, use `./gradlew` in this directory.
##
##############################################################################

# Attempt to locate a Java runtime.
if [ -z "$JAVA_HOME" ]; then
  javaExecutable="$(command -v java)"
else
  javaExecutable="$JAVA_HOME/bin/java"
fi

if [ -z "$javaExecutable" ]; then
  echo "ERROR: Could not find a Java runtime."
  exit 1
fi

# Resolve the application home.
APP_HOME=$(CDPATH= cd -- "$PWD"/"$(dirname -- "$0")" && pwd)
CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

if [ ! -f "$CLASSPATH" ]; then
  echo "ERROR: Gradle wrapper JAR not found."
  exit 1
fi

# Determine the Java command to use to start the Gradle daemon.
JAVA_CMD="$javaExecutable"

# Run the Gradle wrapper.
exec "$JAVA_CMD" -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
