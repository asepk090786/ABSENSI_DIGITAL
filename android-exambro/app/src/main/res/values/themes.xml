<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme -->
    <style name="Theme.ExamBro" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorError">@color/error</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:navigationBarColor">@color/primary_dark</item>
    </style>

    <!-- Splash screen theme (no action bar, full-screen) -->
    <style name="Theme.ExamBro.Splash" parent="Theme.ExamBro">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/splash_background</item>
    </style>

    <!-- Exam activity: no action bar, full screen -->
    <style name="Theme.ExamBro.Exam" parent="Theme.ExamBro">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Dialog-style theme for PIN entry -->
    <style name="Theme.ExamBro.Dialog" parent="Theme.ExamBro">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">@color/surface</item>
    </style>

</resources>
