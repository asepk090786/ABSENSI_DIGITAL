<?php

namespace App\Exports;

use Maatwebsite\Excel\Concerns\FromArray;
use Maatwebsite\Excel\Concerns\WithColumnWidths;
use Maatwebsite\Excel\Concerns\WithEvents;
use Maatwebsite\Excel\Events\AfterSheet;
use PhpOffice\PhpSpreadsheet\Style\Fill;
use PhpOffice\PhpSpreadsheet\Style\Color;

class KelasSiswaTemplateExport implements FromArray, WithColumnWidths, WithEvents
{
    public function __construct(private int $kelasId)
    {
    }

    public function array(): array
    {
        // Baris 1-5: Petunjuk
        $instructions = [
            ['PETUNJUK PENGISIAN:'],
            ['1. NIS dan NISN: wajib diisi dan unik.'],
            ['2. Nama: wajib diisi (nama lengkap siswa).'],
            ['3. Jenis Kelamin: wajib diisi dengan L (Laki-laki) atau P (Perempuan).'],
            ['4. Email, Username, Password: wajib diisi untuk login sistem.'],
            [], // Baris 6: Kosong (pemisah)
            // Baris 7: Header
            ['nis', 'nisn', 'nama', 'jenis_kelamin', 'email', 'username', 'password'],
            // Baris 8+: Data contoh
            ['2026001', '0065432101', 'Adi Pratama', 'L', 'adi@example.com', 'adi.pratama', 'password123'],
            ['2026002', '0065432102', 'Sari Lestari', 'P', 'sari@example.com', 'sari.lestari', 'password123'],
        ];
        
        return $instructions;
    }

    public function columnWidths(): array
    {
        return [
            'A' => 12,
            'B' => 14,
            'C' => 25,
            'D' => 14,
            'E' => 28,
            'F' => 20,
            'G' => 18,
        ];
    }

    public function registerEvents(): array
    {
        return [
            AfterSheet::class => function (AfterSheet $event) {
                $sheet = $event->sheet->getDelegate();
                
                // Style petunjuk baris 1-5: bold pada baris pertama
                for ($row = 1; $row <= 5; $row++) {
                    for ($col = 'A'; $col <= 'G'; $col++) {
                        $sheet->getStyle($col . $row)->getFont()->setSize(10);
                        if ($row === 1) {
                            $sheet->getStyle($col . $row)->getFont()->setBold(true);
                        }
                    }
                }
                
                // Style header baris 7: biru dengan teks putih
                $headerRow = 7;
                for ($col = 'A'; $col <= 'G'; $col++) {
                    $sheet->getStyle($col . $headerRow)->getFont()->setBold(true);
                    $sheet->getStyle($col . $headerRow)->getFont()->setColor(
                        new Color('FFFFFF')
                    );
                    $sheet->getStyle($col . $headerRow)->getFill()->setFillType(
                        Fill::FILL_SOLID
                    );
                    $sheet->getStyle($col . $headerRow)->getFill()->getStartColor()->setRGB('4472C4');
                }
            },
        ];
    }
}
